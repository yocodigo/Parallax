# Alpaca API credentials. Get these from https://app.alpaca.markets/ under "API Keys".
# Copy this file to .env.local and fill in your values. Never commit .env.local.
# Paper and live accounts use separate keys, and the host must match the keys.

ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
ALPACA_TRADING_HOST=https://paper-api.alpaca.markets
# Local Postgres from compose.yaml. Production uses a hosted database URL instead.
DATABASE_URL=postgres://parallax:parallax@localhost:5432/parallax
# ElevenLabs, for transcribing voice journal entries (Scribe speech-to-text).
# Create a key at https://elevenlabs.io/app/settings/api-keys.
ELEVENLABS_API_KEY=

# Anthropic, for turning voice note transcripts into draft plans and reviews.
# Create a key at https://platform.claude.com/settings/keys.
ANTHROPIC_API_KEY=

# Sign-in. Every page and API route needs a session; /login takes this password.
# Use a long random one, e.g. `openssl rand -base64 24`.
APP_PASSWORD=
# Signs the session cookie; at least 32 characters, e.g. `openssl rand -base64 32`.
# Changing it signs out every browser.
SESSION_SECRET=

# Set to true only for the public demo deployment (its own database of fake trades):
# no sign-in, and every write is refused. Set it in the demo project's build env and
# rebuild after changing it; never set it on the real deployment's runtime alone.
# The demo's Alpaca keys should be a separate, empty paper account.
NEXT_PUBLIC_DEMO_MODE=
