# Alpaca API credentials. Get these from https://app.alpaca.markets/ under "API Keys".
# Copy this file to .env.local and fill in your values. Never commit .env.local.
# Paper and live accounts use separate keys, and the host must match the keys.

ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
ALPACA_TRADING_HOST=https://paper-api.alpaca.markets
# Local Postgres from compose.yaml. Production uses a hosted database URL instead.
DATABASE_URL=postgres://parallax:parallax@localhost:5432/parallax
# ElevenLabs, for transcribing voice journal entries (Scribe speech-to-text).
# Create a key at https://elevenlabs.io/app/settings/api-keys.
ELEVENLABS_API_KEY=
